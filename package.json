{
  "name": "pi-anon-export",
  "version": "0.1.1",
  "type": "module",
  "description": "Pi extension that exports agent sessions as anonymized JSONL or HTML, matching /export's paths and formats: redacts secrets from your shell rc files, strips or flags screenshots, verifies the result, zips a whole project. Fully offline.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tychenjiajun/pi-anon-export.git"
  },
  "homepage": "https://pi.dev/packages/pi-anon-export",
  "bugs": {
    "url": "https://github.com/tychenjiajun/pi-anon-export/issues"
  },
  "author": "Jiajun Chen <tychenjiajun@live.cn>",
  "keywords": [
    "pi-package",
    "pi-extension",
    "anonymize",
    "redact",
    "redaction",
    "secrets",
    "pii",
    "privacy",
    "screenshot",
    "session",
    "jsonl",
    "html",
    "export",
    "zip",
    "offline",
    "share",
    "pi",
    "pi-coding-agent"
  ],
  "license": "MIT AND Apache-2.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "extensions/**/*.ts",
    "README.md",
    "LICENSE",
    "LICENSE-APACHE"
  ],
  "pi": {
    "extensions": [
      "./extensions/anon-export.ts"
    ],
    "image": "https://raw.githubusercontent.com/tychenjiajun/pi-anon-export/main/assets/preview.png",
    "video": "https://raw.githubusercontent.com/tychenjiajun/pi-anon-export/main/assets/demo.mp4"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "smoke": "node scripts/smoke.ts && node scripts/anonymize-smoke.ts && node scripts/hypothesis-smoke.ts",
    "test": "npm run check && npm run smoke"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
