{
  "name": "pi-anon-export",
  "version": "0.1.0",
  "type": "module",
  "description": "Pi extension that exports sessions as anonymized JSONL: redacts literal secrets pulled from your env files, strips or flags embedded images, drops unparseable lines, and optionally zips every session of the current project. Fully offline — nothing ever leaves your machine.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "anonymize",
    "redaction",
    "privacy",
    "session",
    "jsonl",
    "export",
    "offline",
    "pi",
    "pi-coding-agent",
    "ai-coding"
  ],
  "license": "MIT AND Apache-2.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "extensions/**/*.ts",
    "README.md",
    "LICENSE",
    "LICENSE-APACHE"
  ],
  "pi": {
    "extensions": [
      "./extensions/anon-export.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "smoke": "node scripts/smoke.ts",
    "test": "npm run check && npm run smoke"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
